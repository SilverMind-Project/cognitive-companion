# Cognitive Companion v2 - Environment Variables
# Copy to .env and fill in your values.

# ─── PostgreSQL Database ─────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cognitive-companion

# ─── LLM Endpoints (external to compose) ────────────────────────
VISION_MODEL_URL=http://localhost:8001
GEMMA_MODEL_URL=http://localhost:8100
# Google Gemini (for realtime voice  optional)
GEMINI_API_KEY=change-me-key


# ─── Person Identification Service
PERSON_ID_SERVICE_URL=http://localhost:8200

# ─── Scene Analysis Service
SCENE_ANALYSIS_URL=http://localhost:8300

# ─── Semantic Memory Service
SCENE_ANALYSIS_URL=http://localhost:8300

# ─── Continuous Tracking Service / Tracking Orchestrator Service
TRACKING_ORCHESTRATOR_URL=http://localhost:8500

# ─── TTS (external to compose)
TTS_API_URL=http://localhost:8600/v1


# Home Assistant
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CAREGIVER_CHAT_ID=
TELEGRAM_OPENCLAW_CHAT_ID=

# API keys
CC_ADMIN_API_KEY=change-me-admin-key
CC_CAREGIVER_API_KEY=change-me-caregiver-key
CC_MCP_API_KEY=change-me-mcp-key
