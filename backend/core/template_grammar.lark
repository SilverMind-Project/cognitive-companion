?start: expr
?expr: or_expr
?or_expr: and_expr ("or" and_expr)*
?and_expr: not_expr ("and" not_expr)*
?not_expr: "not" not_expr -> not_op | comparison
?comparison: term (COMP_OP term)?
?term: STRING -> string
     | NUMBER -> number
     | BOOL -> boolean
     | NULL -> null
     | func_call -> func_call
     | "(" expr ")"
     | path -> path

path: NAME ("." (NAME | INT))* (VBAR JMESPATH)?

func_call: NAME "(" [expr ("," expr)*] ")"

COMP_OP: "==" | "!=" | ">=" | "<=" | ">" | "<"
NULL: "null"
BOOL: "true" | "false"
INT: /[0-9]+/
NUMBER: /-?\d+(?:\.\d+)?/
STRING: /"[^"]*"/ | /'[^']*'/

// Must come after BOOL/INT/NUMBER to avoid shadowing
NAME: /(?!true\b|false\b|null\b|and\b|or\b|not\b)[a-zA-Z_][a-zA-Z0-9_]*/

// Pipe operator for JMESPath expressions
VBAR: "|"

// JMESPath expression body after the pipe.
// Stops before comparison operators so that "path | length(@) > 0"
// is parsed as (path | length(@)) > 0 rather than path | length(@) > 0
// where the JMESPath greedily consumes "length(@) > 0" as one token.
JMESPATH: /[^|}><=!]+/

%import common.WS
%ignore WS
