{
  "schema_version": 1,
  "rule": {
    "name": "daily_living_meal_close",
    "description": "DL-M04 companion to daily_living_meal_open. Closes the open meal_eating ActivitySession once the resident has left the dining room for at least merge_gap_minutes (daily_living.meals.merge_gap_minutes; the '20' literal in this rule's condition mirrors that setting), so a bathroom break during lunch continues the same session instead of starting a second one. PLACEHOLDERS: __RESIDENT_PERSON_ID__, __DINING_ROOM_NAME__.",
    "enabled": true,
    "trigger_types": ["cron"],
    "cool_off_minutes": 0,
    "max_daily_triggers": 0,
    "max_concurrent_executions": 1,
    "execution_timeout_minutes": 5,
    "cron_expressions": [{"expression": "*/5 * * * *", "timezone": "UTC"}]
  },
  "contexts": [],
  "steps": [
    {
      "label": "presence",
      "step_type": "presence_query",
      "config": {"person_id": "__RESIDENT_PERSON_ID__", "output_key": "presence"}
    },
    {
      "label": "should_close",
      "step_type": "condition",
      "config": {
        "expression": "steps.presence.outputs.presence_room_name != \"__DINING_ROOM_NAME__\" and steps.presence.outputs.presence_dwell_minutes != null and steps.presence.outputs.presence_dwell_minutes >= 20"
      }
    },
    {
      "label": "end",
      "step_type": "activity_session_end",
      "config": {
        "activity_type": "meal_eating",
        "person_id": "__RESIDENT_PERSON_ID__",
        "write_activity_record": true
      }
    }
  ],
  "edges": [
    {"source_label": "presence", "source_port": "main", "target_label": "should_close", "target_port": "main"},
    {"source_label": "should_close", "source_port": "true", "target_label": "end", "target_port": "main"}
  ]
}
