# scripts/ccwin settings for your Windows build PC. Copy to scripts/ccwin.local.env
# (gitignored: it describes your own network and PC) and fill in. Values already set
# in the environment win. See scripts/windows/README.md.

# The PC's Host entry in ~/.ssh/config (address, User, IdentityFile, IdentitiesOnly).
CCWIN_HOST=buildpc
# That entry's identity file, checked by `ccwin doctor` (optional).
CCWIN_SSH_KEY=~/.ssh/buildpc_ed25519
# The build account's root folder on the PC; it holds bin, locks, runs, staging, repos.
CCWIN_REMOTE_ROOT='C:\ccwin'
# The emulators `scripts/ccwin avd-setup` creates and `test-instrumented` boots.
CCWIN_TABLET_AVD=companion_tablet_api35
CCWIN_TV_AVD=companion_googletv_api36
# The room-less companion surface the test device registers and connects as.
CCWIN_SURFACE_ID=ccwin-test-device
